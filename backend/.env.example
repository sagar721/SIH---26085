PROJECT_NAME="M-FLOOD"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Database (PostgreSQL + PostGIS)
# Set your local or docker database connection string here:
DATABASE_URL=
# Runtime simulation and alert records use SQLite until a shared job store is configured.
RUNTIME_STORE_PATH=data/runtime_store.db
# Set these in deployed environments to route simulations through Redis/Celery.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
ALLOW_INPROCESS_SIMULATION_FALLBACK=False
# True by default — a plain local run keeps refreshing weather/data in-process
# with zero extra setup. Set False only when running the dedicated `scheduler`
# service (see docker-compose.yml / scripts/run_scheduler.py) so the refresh
# loops run in exactly one place instead of twice.
RUN_SCHEDULED_REFRESHES_IN_API=True
# Authentication is enforced when JWT_SECRET_KEY is set.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
TIDAL_STAGE_M=0.0
DRAINAGE_OUTFALL_CAPACITY_M3S=
AUTH_ADMIN_USERNAME=
# Generate with: python -c "from app.core.auth import hash_password; print(hash_password('your-password'))"
AUTH_ADMIN_PASSWORD_HASH=
AUTH_OPERATOR_USERNAME=
AUTH_OPERATOR_PASSWORD_HASH=
# Plaintext AUTH_ADMIN_PASSWORD / AUTH_OPERATOR_PASSWORD are accepted ONLY when
# ALLOW_INSECURE_LOCAL_AUTH=True and ENVIRONMENT=development, and only as a
# fallback when no *_PASSWORD_HASH is set — never use them in production.
AUTH_ADMIN_PASSWORD=
AUTH_OPERATOR_PASSWORD=
ALLOW_INSECURE_LOCAL_AUTH=False

# External OIDC login (see app/core/auth.py verify_oidc_identity). Verification
# is JWKS/RS256-based against the real provider's published public keys — there
# is no fallback to any locally-known secret. All three of OIDC_ISSUER_URL,
# OIDC_CLIENT_ID, and OIDC_JWKS_URL must be set for OIDC_ENABLED=True to work;
# otherwise oidc/login fails closed (503) rather than accepting a weaker check.
OIDC_ENABLED=False
OIDC_PROVIDER_NAME=Google
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=

# For Docker Compose only; use a unique secret, never commit the real value.
POSTGRES_PASSWORD=replace-with-a-unique-secret

# External Weather & Data Providers (leave empty if not configured; system will report NOT_CONFIGURED)
TOMORROW_API_KEY=
IMD_API_KEY=
MCGM_RAIN_GAUGE_URL=
IMD_RADAR_URL=
EARTHDATA_TOKEN=
# LIVE/FORECAST simulation runs reject a weather reading older than this.
WEATHER_MAX_AGE_SECONDS=900

# BMC ArcGIS Portal Base URL
BMC_GIS_URL=https://prsrvgisapp.mcgm.gov.in/server/rest/services/mcgm/MCGMGIS_Departments_Master_All_Layers/MapServer

# Paths to Configuration Files
STUDY_AREA_CONFIG=config/study_area.json
THRESHOLDS_CONFIG=config/thresholds.json
PROVIDERS_CONFIG=config/providers.json
